# ── Site ───────────────────────────────────────────────────────────────
# Production origin. Canonical URLs, sitemap, robots, Open Graph, JSON-LD and
# llms.txt all derive from this. Change it here when moving to a custom domain;
# yaqubnaqib.vercel.app then permanently redirects to it.
NEXT_PUBLIC_SITE_URL=https://yaqubnaqib.vercel.app

# ── Search engine verification (optional) ──────────────────────────────
# Google Search Console → "HTML tag" method → content value only.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Bing Webmaster Tools → "Meta tag" method → content value only.
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# ── Contact form delivery (server-only; pick one) ──────────────────────
# Option A: Resend (https://resend.com)
RESEND_API_KEY=
CONTACT_TO_EMAIL=yaqub.nq@gmail.com
# Requires a verified domain; without one Resend only allows onboarding@resend.dev
CONTACT_FROM_EMAIL=
# Option B: EmailJS REST API from the server. Enable "Allow EmailJS API for
# non-browser applications" in EmailJS → Account → Security.
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=

# ── Spam protection (optional but recommended) ─────────────────────────
# Cloudflare Turnstile (https://dash.cloudflare.com → Turnstile)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Upstash Redis for rate limiting shared across serverless instances.
# Without it, a per-instance in-memory limiter is used.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
